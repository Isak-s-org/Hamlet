{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@hamlet/daemon#dev": {
      "cache": false,
      "persistent": true,
      "interactive": true
    }
  }
}
