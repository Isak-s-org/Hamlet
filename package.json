{
  "name": "agent-civ",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "daemon": "pnpm --filter @agent-civ/daemon dev",
    "install-hooks": "pnpm --filter @agent-civ/installer start install",
    "uninstall-hooks": "pnpm --filter @agent-civ/installer start uninstall",
    "typecheck": "tsc -b",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
